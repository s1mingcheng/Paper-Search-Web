# 复制为 .env 后填写。已设置的系统环境变量优先于本文件。
# 留空的 API Key 不影响其他公开数据源的基础检索。
PAPER_SEARCH_HOST=127.0.0.1
PAPER_SEARCH_PORT=8000

# 可选：DeepSeek 双语选词与摘要概括
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_ITEMS=20

# 可选：学术数据源认证与联系邮箱
OPENALEX_API_KEY=
OPENALEX_EMAIL=
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=

# auto：本地词库 + MyMemory；local 或 none：只使用本地词库
TRANSLATION_PROVIDER=auto
MYMEMORY_EMAIL=
